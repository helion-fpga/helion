# run_uram_column.tcl -- one Vivado run for job-5 pass C (one URAM per column).
#
# Usage:
#   vivado -mode batch -source run_uram_column.tcl -tclargs \
#     <fpga_part> <column_verilog> <sites_file> <out_dir>
#
# Example:
#   vivado -mode batch -source run_uram_column.tcl -tclargs \
#     xcvu3p-ffvc1517-2-e column_design.v out/column_sites.txt out/col
#
# Non-project flow, following the standard flow template in
# vivado-fuzzing-instructions.md: read_verilog, synth_design,
# opt_design, place_design, route_design, write_bitstream. The design
# holds one URAM288 per URAM column (generated by
# gen_uram_column_design.py from the site list); each instance
# URAM288_col<i> is placed at the <i>th site in the sites file with
# place_cell. The .ll file maps every column's cell to its frames,
# which is the device-file input for URAM columns.
#
# The driver exits nonzero if synthesis does not produce exactly as
# many URAM288 cells as there are sites, if any place_cell fails, or
# if any of .bit/.rbt/.ll is missing.
#
# Outputs in <out_dir>: uram.bit, uram.rbt, uram.ll, post_route.dcp,
# run_info.txt (part, site list, Vivado version).
#
# No em dashes anywhere.

if { [llength $::argv] != 4 } {
  puts "received mandatory args: $::argv"
  puts "expected mandatory args: <fpga_part> <column_verilog> <sites_file> <out_dir>"
  exit 1
}

set fpga_part [lindex $::argv 0]
set column_verilog [lindex $::argv 1]
set sites_file [lindex $::argv 2]
set out_dir [lindex $::argv 3]

file mkdir ${out_dir}

set fp [open ${sites_file} r]
set sites [split [read ${fp}] "\n"]
close ${fp}
set sites [lsearch -all -inline -not -exact ${sites} ""]
set n_sites [llength ${sites}]
if { ${n_sites} == 0 } {
  puts "ERROR: no sites in ${sites_file}"
  exit 1
}

read_verilog ${column_verilog}
synth_design -top uram_columns -part ${fpga_part}

set uram_cells [get_cells -hierarchical -filter {REF_NAME == URAM288}]
if { [llength ${uram_cells}] != ${n_sites} } {
  puts "ERROR: expected ${n_sites} URAM288 cells, found [llength ${uram_cells}]"
  exit 1
}
for {set i 0} {${i} < ${n_sites}} {incr i} {
  set cell "URAM288_col${i}"
  set site [lindex ${sites} ${i}]
  place_cell [get_cells ${cell}] ${site}
}

opt_design
place_design
route_design
write_checkpoint -force ${out_dir}/post_route.dcp

write_bitstream -force -raw_bitfile -logic_location_file ${out_dir}/uram.bit

set fp [open ${out_dir}/run_info.txt w]
puts ${fp} "part: ${fpga_part}"
puts ${fp} "column_verilog: ${column_verilog}"
puts ${fp} "sites_file: ${sites_file}"
puts ${fp} "uram_columns: ${n_sites}"
puts ${fp} "vivado_version: [version]"
close ${fp}

foreach suffix {bit rbt ll} {
  set path ${out_dir}/uram.${suffix}
  if { ![file exists ${path}] } {
    puts "ERROR: missing output ${path}"
    exit 1
  }
}
puts "run complete: ${out_dir}/uram.bit, uram.rbt, uram.ll (${n_sites} columns)"
