# Q6 step 1: HPIO tile inventory arbiter for xcku3p.
#
# Purpose: settle the HPIO_RIGHT vs HPIO_L question on xcku3p-ffva676-1-e
# and list every HPIO/HDIO/CMT tile with its real Vivado name, column,
# row, clock region, IOB sites, and package pins. No bitstream is
# generated, so no implementation license checkout is involved: this is
# a PinPlanning probe, the same mode BitFiltrator's
# extract_device_info.tcl uses.
#
# Run (on the cluster, from the probe directory):
#
#   vivado -mode batch -source tcl/q6_hpio_inventory.tcl -notrace \
#     -tclargs xcku3p-ffva676-1-e q6-step1-hpio-inventory.txt
#
# Output: q6-step1-hpio-inventory.txt, plain text, one record per line.
# Keep this file and bring it back verbatim; q6_check_step1.py reads it.
#
# Format (lines starting with # are comments):
#   PART <part>
#   COUNT <tile_type_pattern> <n>
#   TILE <tile_name> <tile_type> <column> <row> <clock_region> <site_count>
#   SITE <tile_name> <site_name> <site_type> <package_pin_or_NONE>
#
# No em dashes anywhere.
#
# This script is original Helion crew work. It only calls Vivado Tcl
# commands also used by the vendored BitFiltrator scripts.

proc q6_emit_inventory { fpga_part out_path } {
  create_project "q6_hpio_inventory" -in_memory -part ${fpga_part}
  set_property DESIGN_MODE PinPlanning [current_fileset]
  open_io_design -name io_1

  set fp [open ${out_path} w]
  puts ${fp} "# Q6 step 1 HPIO inventory, part ${fpga_part}"
  puts ${fp} "# generated by q6_hpio_inventory.tcl; keep verbatim"
  puts ${fp} "PART ${fpga_part}"

  foreach pattern {HPIO* HDIO* CMT*} {
    set tiles [get_tiles -quiet -filter "TILE_TYPE =~ ${pattern}"]
    puts ${fp} "COUNT ${pattern} [llength ${tiles}]"
    foreach tile [lsort -dictionary ${tiles}] {
      set tile_type [get_property TILE_TYPE ${tile}]
      set col [get_property COLUMN ${tile}]
      set row [get_property ROW ${tile}]
      set clock_region [get_property CLOCK_REGION ${tile}]
      set sites [get_sites -quiet -of_objects ${tile}]
      puts ${fp} "TILE ${tile} ${tile_type} ${col} ${row} ${clock_region} [llength ${sites}]"
      foreach site [lsort -dictionary ${sites}] {
        set site_type [get_property SITE_TYPE ${site}]
        # Package pin lookup may fail for sites with no pin (for
        # example BIAS and VREF sites); record NONE and keep going.
        set pin "NONE"
        if { [catch {set pins [get_package_pins -quiet -of_objects ${site}]}] == 0 } {
          if { [llength ${pins}] > 0 } {
            set pin [lindex ${pins} 0]
          }
        }
        puts ${fp} "SITE ${tile} ${site} ${site_type} ${pin}"
      }
    }
  }

  # Arbiter queries, recorded as counts so the verdict does not depend
  # on anyone eyeballing the tile list.
  foreach exact {HPIO_RIGHT HPIO_L HDIO_TOP_RIGHT HDIO_BOT_RIGHT CMT_RIGHT CMT_L} {
    set tiles [get_tiles -quiet -filter "TILE_TYPE == ${exact}"]
    puts ${fp} "COUNT_EXACT ${exact} [llength ${tiles}]"
  }

  close ${fp}
  puts "Q6 step 1 inventory written to ${out_path}"
}

if { [llength $::argv] != 2 } {
  puts "received mandatory args: $::argv"
  puts "expected mandatory args: <fpga_part> <inventory_out>"
} else {
  set fpga_part [lindex $::argv 0]
  set out_path [lindex $::argv 1]
  q6_emit_inventory ${fpga_part} ${out_path}
}
